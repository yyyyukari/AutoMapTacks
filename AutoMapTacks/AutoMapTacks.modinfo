  <FrontEndActions>
    <UpdateDatabase id="amt_settings">
      <Properties>
        <LoadOrder>13000</LoadOrder>
      </Properties>
      <File>amt_config.xml</File>
    </UpdateDatabase>
    <UpdateText id="amt_text">
      <File Priority="1">amt_text.xml</File>
    </UpdateText>
  </FrontEndActions>

  <InGameActions>
    <UpdateText id="amt_ingame_text">
      <Properties>
        <LoadOrder>13000</LoadOrder>
      </Properties>
      <File Priority="1">amt_text.xml</File>
    </UpdateText>
    <AddUserInterfaces id="amt_ui">
      <Properties>
        <LoadOrder>13000</LoadOrder>
        <Context>InGame</Context>
      </Properties>
      <File>amt_autoplanner.xml</File>
    </AddUserInterfaces>
    <AddUserInterfaces id="amt_entry_ui">
      <Properties>
        <LoadOrder>12990</LoadOrder>
        <Context>InGame</Context>
      </Properties>
      <File>amt_entry.xml</File>
    </AddUserInterfaces>
  </InGameActions>

  <Files>
    <File>amt_config.xml</File>
    <File>amt_text.xml</File>
    <File>amt_autoplanner.xml</File>
    <File>amt_autoplanner.lua</File>
    <File>amt_wonderplanner.lua</File>
