<Mod id="a3f7d2e1-9c4b-4e8a-bb13-7d11f9c2a04e" version="40">
  <Properties>
    <Name>LOC_AMT_R40_MOD_NAME</Name>
    <Authors>yyyyukari</Authors>
    <Teaser>LOC_AMT_R40_MOD_TEASER</Teaser>
    <Description>LOC_AMT_R40_MOD_DESCRIPTION</Description>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="4ecfcc62-5471-4435-b295-590df213e8d8" title="Detailed Map Tacks" />
  </Dependencies>

  <LocalizedText>
    <Text id="LOC_AMT_R40_MOD_NAME">
      <en_US>Auto Map Tacks Planner [r40]</en_US>
      <de_DE>Auto Map Tacks Planner [r40]</de_DE>
      <es_ES>Auto Map Tacks Planner [r40]</es_ES>
      <fr_FR>Auto Map Tacks Planner [r40]</fr_FR>
      <it_IT>Auto Map Tacks Planner [r40]</it_IT>
      <ja_JP>Auto Map Tacks Planner [r40]</ja_JP>
      <ko_KR>Auto Map Tacks Planner [r40]</ko_KR>
      <pl_PL>Auto Map Tacks Planner [r40]</pl_PL>
      <pt_BR>Auto Map Tacks Planner [r40]</pt_BR>
      <ru_RU>Auto Map Tacks Planner [r40]</ru_RU>
      <zh_Hans_CN>自动地图钉规划 [r40]</zh_Hans_CN>
      <zh_Hant_HK>自動地圖釘規劃 [r40]</zh_Hant_HK>
    </Text>
    <Text id="LOC_AMT_R40_MOD_TEASER">
      <en_US>Choose single-city planning or linked planning for up to four cities (test) from one entry. Preview, apply and undo district, improvement and wonder plans. [r40]</en_US>
      <de_DE>Choose single-city planning or linked planning for up to four cities (test) from one entry. Preview, apply and undo district, improvement and wonder plans. [r40]</de_DE>
      <es_ES>Choose single-city planning or linked planning for up to four cities (test) from one entry. Preview, apply and undo district, improvement and wonder plans. [r40]</es_ES>
      <fr_FR>Choose single-city planning or linked planning for up to four cities (test) from one entry. Preview, apply and undo district, improvement and wonder plans. [r40]</fr_FR>
      <it_IT>Choose single-city planning or linked planning for up to four cities (test) from one entry. Preview, apply and undo district, improvement and wonder plans. [r40]</it_IT>
      <ja_JP>Choose single-city planning or linked planning for up to four cities (test) from one entry. Preview, apply and undo district, improvement and wonder plans. [r40]</ja_JP>
      <ko_KR>Choose single-city planning or linked planning for up to four cities (test) from one entry. Preview, apply and undo district, improvement and wonder plans. [r40]</ko_KR>
      <pl_PL>Choose single-city planning or linked planning for up to four cities (test) from one entry. Preview, apply and undo district, improvement and wonder plans. [r40]</pl_PL>
      <pt_BR>Choose single-city planning or linked planning for up to four cities (test) from one entry. Preview, apply and undo district, improvement and wonder plans. [r40]</pt_BR>
      <ru_RU>Choose single-city planning or linked planning for up to four cities (test) from one entry. Preview, apply and undo district, improvement and wonder plans. [r40]</ru_RU>
      <zh_Hans_CN>从同一入口选择单城规划或最多四城联动（测试），支持区域、改良和奇观的预览、确认与撤销。[r40]</zh_Hans_CN>
      <zh_Hant_HK>從同一入口選擇單城規劃或最多四城聯動（測試），支援區域、改良和奇觀的預覽、確認與復原。[r40]</zh_Hant_HK>
    </Text>
    <Text id="LOC_AMT_R40_MOD_DESCRIPTION">
      <en_US>Choose single-city planning or linked planning for up to four cities (test) from one entry. Preview, apply and undo district, improvement and wonder plans. [r40]</en_US>
