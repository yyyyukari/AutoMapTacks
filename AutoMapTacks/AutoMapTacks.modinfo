<?xml version="1.0" encoding="utf-8"?>
<Mod id="a3f7d2e1-9c4b-4e8a-bb13-7d11f9c2a04e" version="60">
  <Properties>
    <Name>LOC_AMT_V60_MOD_NAME</Name>
    <Authors>yyyyukari</Authors>
    <Teaser>LOC_AMT_V60_MOD_TEASER</Teaser>
    <Description>LOC_AMT_V60_MOD_DESCRIPTION</Description>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="4ecfcc62-5471-4435-b295-590df213e8d8" title="Detailed Map Tacks" />
  </Dependencies>

  <LocalizedText>
    <Text id="LOC_AMT_V60_MOD_NAME">
      <en_US>Auto Map Tacks Planner</en_US>
      <de_DE>Auto Map Tacks Planner</de_DE>
      <es_ES>Auto Map Tacks Planner</es_ES>
      <fr_FR>Auto Map Tacks Planner</fr_FR>
      <it_IT>Auto Map Tacks Planner</it_IT>
      <ja_JP>Auto Map Tacks Planner</ja_JP>
      <ko_KR>Auto Map Tacks Planner</ko_KR>
      <pl_PL>Auto Map Tacks Planner</pl_PL>
      <pt_BR>Auto Map Tacks Planner</pt_BR>
      <ru_RU>Auto Map Tacks Planner</ru_RU>
      <zh_Hans_CN>自动地图钉规划</zh_Hans_CN>
      <zh_Hant_HK>自動地圖釘規劃</zh_Hant_HK>
    </Text>
    <Text id="LOC_AMT_V60_MOD_TEASER">
      <en_US>Plan one selected city's districts, improvements, and wonders with population-aware optimization.</en_US>
      <de_DE>Plan one selected city's districts, improvements, and wonders with population-aware optimization.</de_DE>
      <es_ES>Plan one selected city's districts, improvements, and wonders with population-aware optimization.</es_ES>
      <fr_FR>Plan one selected city's districts, improvements, and wonders with population-aware optimization.</fr_FR>
      <it_IT>Plan one selected city's districts, improvements, and wonders with population-aware optimization.</it_IT>
      <ja_JP>Plan one selected city's districts, improvements, and wonders with population-aware optimization.</ja_JP>
      <ko_KR>Plan one selected city's districts, improvements, and wonders with population-aware optimization.</ko_KR>
      <pl_PL>Plan one selected city's districts, improvements, and wonders with population-aware optimization.</pl_PL>
      <pt_BR>Plan one selected city's districts, improvements, and wonders with population-aware optimization.</pt_BR>
      <ru_RU>Plan one selected city's districts, improvements, and wonders with population-aware optimization.</ru_RU>
      <zh_Hans_CN>根据人口预算，为单座城市规划区域、改良设施和奇观。</zh_Hans_CN>
      <zh_Hant_HK>根據人口預算，為單座城市規劃區域、改良設施和奇觀。</zh_Hant_HK>
    </Text>
    <Text id="LOC_AMT_V60_MOD_DESCRIPTION">
      <en_US>Plan one selected city's districts, improvements, and wonders with population-aware heuristic optimization and a full preview report. [v60]</en_US>
      <de_DE>Plan one selected city's districts, improvements, and wonders with population-aware heuristic optimization and a full preview report. [v60]</de_DE>
      <es_ES>Plan one selected city's districts, improvements, and wonders with population-aware heuristic optimization and a full preview report. [v60]</es_ES>
      <fr_FR>Plan one selected city's districts, improvements, and wonders with population-aware heuristic optimization and a full preview report. [v60]</fr_FR>
      <it_IT>Plan one selected city's districts, improvements, and wonders with population-aware heuristic optimization and a full preview report. [v60]</it_IT>
      <ja_JP>Plan one selected city's districts, improvements, and wonders with population-aware heuristic optimization and a full preview report. [v60]</ja_JP>
      <ko_KR>Plan one selected city's districts, improvements, and wonders with population-aware heuristic optimization and a full preview report. [v60]</ko_KR>
      <pl_PL>Plan one selected city's districts, improvements, and wonders with population-aware heuristic optimization and a full preview report. [v60]</pl_PL>
      <pt_BR>Plan one selected city's districts, improvements, and wonders with population-aware heuristic optimization and a full preview report. [v60]</pt_BR>
      <ru_RU>Plan one selected city's districts, improvements, and wonders with population-aware heuristic optimization and a full preview report. [v60]</ru_RU>
      <zh_Hans_CN>为所选单座城市规划区域、改良设施和奇观，结合人口预算进行启发式组合优化，并在放置前生成完整规划报告。[v60]</zh_Hans_CN>
      <zh_Hant_HK>為所選單座城市規劃區域、改良設施和奇觀，結合人口預算進行啟發式組合優化，並在放置前生成完整規劃報告。[v60]</zh_Hant_HK>
    </Text>
  </LocalizedText>

  <FrontEndActions>
    <UpdateDatabase id="amt_settings">
      <Properties>
        <LoadOrder>13000</LoadOrder>
      </Properties>
      <File>amt_config.xml</File>
    </UpdateDatabase>
    <UpdateText id="amt_text">
      <File Priority="1">amt_text.xml</File>
    </UpdateText>
  </FrontEndActions>

  <InGameActions>
    <UpdateText id="amt_ingame_text">
      <Properties>
        <LoadOrder>13000</LoadOrder>
      </Properties>
      <File Priority="1">amt_text.xml</File>
    </UpdateText>
    <AddUserInterfaces id="amt_ui">
      <Properties>
        <LoadOrder>13000</LoadOrder>
        <Context>InGame</Context>
      </Properties>
      <File>amt_autoplanner.xml</File>
    </AddUserInterfaces>
    <AddUserInterfaces id="amt_entry_ui">
      <Properties>
        <LoadOrder>12990</LoadOrder>
        <Context>InGame</Context>
      </Properties>
      <File>amt_entry.xml</File>
    </AddUserInterfaces>
  </InGameActions>

  <Files>
    <File>amt_config.xml</File>
    <File>amt_text.xml</File>
    <File>amt_autoplanner.xml</File>
    <File>amt_autoplanner.lua</File>
    <File>amt_wonderplanner.lua</File>
    <File>amt_entry.xml</File>
    <File>amt_entry.lua</File>
  </Files>
</Mod>
